{
  "manifest_version": 3,
  "name": "Attendease – CCBP & eFlow Sync",
  "version": "1.1.0",
  "description": "Scrape absent student names from the CCBP instructor platform and auto-sync with Attendease. Also auto-marks absent on eFlow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://niat-instructor-platform.ccbp.in/*",
    "https://attend-niat.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://eflow.geetauniversity.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Attendease – Sync from CCBP / eFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://niat-instructor-platform.ccbp.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eflow.geetauniversity.com/*"
      ],
      "js": [
        "eflow-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}